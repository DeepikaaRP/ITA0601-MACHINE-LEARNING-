import pandas as pd
from sklearn.tree import DecisionTreeClassifier, plot_tree
import matplotlib.pyplot as plt

# Create the dataset
data = {
    'Internet': ['Fast', 'Fast', 'Slow', 'Fast', 'Slow',
                 'Medium', 'Medium', 'Fast', 'Slow', 'Medium'],
    'Device': ['Laptop', 'Mobile', 'Laptop', 'Tablet', 'Mobile',
               'Laptop', 'Mobile', 'Laptop', 'Tablet', 'Tablet'],
    'Study_Mode': ['Video', 'Video', 'Reading', 'Video', 'Reading',
                   'Reading', 'Video', 'Reading', 'Video', 'Reading'],
    'Result': ['Pass', 'Pass', 'Fail', 'Pass', 'Fail',
               'Pass', 'Pass', 'Pass', 'Fail', 'Fail']
}

df = pd.DataFrame(data)

print("Training Dataset:")
print(df)

# Separate input attributes and target
X = df[['Internet', 'Device', 'Study_Mode']]
y = df['Result']

# Convert categorical data into numeric form
X_encoded = pd.get_dummies(X)

# Build the ID3-style decision tree using entropy
model = DecisionTreeClassifier(
    criterion='entropy',
    random_state=0
)
model.fit(X_encoded, y)

# Display the decision tree
plt.figure(figsize=(14, 7))
plot_tree(
    model,
    feature_names=X_encoded.columns,
    class_names=model.classes_,
    filled=True,
    rounded=True
)
plt.title("Decision Tree Using ID3 (Information Gain)")
plt.show()

# Classify a new sample
new_sample = pd.DataFrame({
    'Internet': ['Fast'],
    'Device': ['Laptop'],
    'Study_Mode': ['Video']
})

new_encoded = pd.get_dummies(new_sample)
new_encoded = new_encoded.reindex(
    columns=X_encoded.columns,
    fill_value=0
)

prediction = model.predict(new_encoded)

print("\nNew Sample:")
print(new_sample)
print("\nPredicted Result:", prediction[0])
