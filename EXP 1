import pandas as pd
from google.colab import files
import io

# Upload dataset
uploaded = files.upload()
df = pd.read_csv(io.BytesIO(next(iter(uploaded.values()))))

print("Training Dataset:")
print(df)

# Initialize FIND-S
attributes = list(df.columns[:-1])
target = df.columns[-1]
hypothesis = ['0'] * len(attributes)

print("\nStep-by-Step Hypothesis:")

for i in range(len(df)):
    row = df.iloc[i]

    if row[target] == "Yes":
        for j in range(len(attributes)):
            value = row[attributes[j]]

            if hypothesis[j] == '0':
                hypothesis[j] = value
            else:
                if hypothesis[j] != value:
                    hypothesis[j] = '?'

        print("After Example", i + 1, ":", hypothesis)

print("\nFinal Most Specific Hypothesis:")
for j in range(len(attributes)):
    print(attributes[j], ":", hypothesis[j])

print("\nFinal Hypothesis:", hypothesis)
