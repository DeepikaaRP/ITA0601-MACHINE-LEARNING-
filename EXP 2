import pandas as pd
from google.colab import files
import io

# Upload the CSV dataset
uploaded = files.upload()
df = pd.read_csv(io.BytesIO(next(iter(uploaded.values()))))

print("Training Dataset:")
print(df)

attributes = list(df.columns[:-1])
target = df.columns[-1]
domains = [list(df[col].unique()) for col in attributes]
n = len(attributes)

# Initialize boundaries
S = [['0'] * n]
G = [['?'] * n]

def covers(h, x):
    return all(h[i] == '?' or h[i] == x[i] for i in range(n))

def generalize(s, x):
    h = s.copy()
    for i in range(n):
        if h[i] == '0':
            h[i] = x[i]
        elif h[i] != x[i]:
            h[i] = '?'
    return h

def specialize(g, x, S):
    result = []
    for i in range(n):
        if g[i] == '?':
            for value in domains[i]:
                if value != x[i]:
                    h = g.copy()
                    h[i] = value
                    if any(covers(h, s) for s in S):
                        result.append(h)
    return result

# Process training examples
for row in df.values.tolist():
    x, label = row[:-1], row[-1]

    if label == 'Yes':
        G = [g for g in G if covers(g, x)]
        S = [
            s if covers(s, x) else generalize(s, x)
            for s in S
        ]
    else:
        S = [s for s in S if not covers(s, x)]
        new_G = []
        for g in G:
            if not covers(g, x):
                new_G.append(g)
            else:
                new_G.extend(specialize(g, x, S))
        G = new_G

    print("\nExample:", x, "| Class:", label)
    print("S Boundary:", S)
    print("G Boundary:", G)

print("\nFinal Specific Boundary S:")
for h in S:
    print(h)

print("\nFinal General Boundary G:")
for h in G:
    print(h)

print("\nVersion Space is bounded by S and G.")
